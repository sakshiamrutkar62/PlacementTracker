# ==============================================
# PLACEMENT TRACKER — Environment Configuration
# ==============================================
# 📝 INSTRUCTIONS:
# 1. Copy this file and rename it to: .env
# 2. Fill in all values below (replace everything in < >)
# 3. NEVER commit the .env file to Git (it's in .gitignore)
# ==============================================

# ----------------------------------------------
# SERVER CONFIGURATION
# ----------------------------------------------
PORT=3000
NODE_ENV=production

# ----------------------------------------------
# DATABASE (Supabase PostgreSQL)
# ----------------------------------------------
# Get this from: Supabase Dashboard → Settings → Database → Connection String (URI mode)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:<your-password>@db.<project-ref>.supabase.co:5432/postgres

# ----------------------------------------------
# SUPABASE API
# ----------------------------------------------
# Get from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<your-service-role-key-or-anon-key>

# ----------------------------------------------
# JWT AUTHENTICATION
# ----------------------------------------------
# Generate a random 32+ character string
# Windows: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 32 | ForEach-Object {[char]$_})
# Mac/Linux: openssl rand -base64 32
JWT_SECRET=<your-super-secret-random-string-min-32-chars>

# ----------------------------------------------
# GOOGLE GEMINI AI (Optional)
# ----------------------------------------------
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=<your-gemini-api-key>

# ----------------------------------------------
# EMAIL CONFIGURATION (Optional - for password reset)
# ----------------------------------------------
# For Gmail:
# 1. Enable 2FA in Google Account
# 2. Generate App Password: https://myaccount.google.com/apppasswords
EMAIL_USER=<your-email@gmail.com>
EMAIL_PASS=<your-app-specific-password>

# ----------------------------------------------
# 🚀 QUICK START CHECKLIST:
# ----------------------------------------------
# ✅ Created Supabase account
# ✅ Created new project in Supabase
# ✅ Copied DATABASE_URL from Supabase
# ✅ Copied SUPABASE_URL and SUPABASE_KEY
# ✅ Generated JWT_SECRET (random string)
# ✅ Created "resumes" storage bucket in Supabase
# ✅ Ran SQL schema from README.md
# ✅ Installed dependencies: npm install
# ✅ Ready to run: npm start
# ==============================================
